# =====================================================================
# Webtokoku - contoh environment variable (TANPA nilai asli).
# Salin ke .env.local (lokal) atau isi di Vercel > Project > Settings >
# Environment Variables. Jangan commit file .env / .env.local.
# Untuk penelitian: gunakan HANYA kredensial project Supabase penelitian,
# jangan pernah kredensial production.
# =====================================================================

# ---------------------------------------------------------------------
# BROWSER-SAFE (prefix NEXT_PUBLIC_ -> ikut ter-bundle ke browser)
# ---------------------------------------------------------------------
# Supabase project URL & anon key (project penelitian).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Nomor WhatsApp admin (format internasional tanpa + / spasi).
# Jika kosong, kode memakai nilai fallback bawaan di lib/plan.ts.
NEXT_PUBLIC_WEBTOKOKU_ADMIN_WA=

# Domain (lib/domains.ts). Jika kosong, kode memakai default production
# (webtokoku.id / webtokoku.vercel.app). Lihat docs/RESEARCH_SETUP.md
# sebelum mengisi untuk deployment penelitian.
NEXT_PUBLIC_PRIMARY_DOMAIN=
NEXT_PUBLIC_STOREFRONT_DOMAIN=
NEXT_PUBLIC_LEGACY_VERCEL_DOMAIN=

# ---------------------------------------------------------------------
# SERVER-ONLY (JANGAN diberi prefix NEXT_PUBLIC_)
# ---------------------------------------------------------------------
# Supabase service role key - bypass RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret key.
TURNSTILE_SECRET_KEY=
# Development only. Jangan set "true" di Production.
TURNSTILE_DEV_BYPASS=

# RajaOngkir / Komerce Shipping Cost API.
RAJAONGKIR_API_KEY=
# Alias opsional untuk RAJAONGKIR_API_KEY.
KOMERCE_SHIPPING_COST_API_KEY=
# Opsional; ada default di kode.
RAJAONGKIR_BASE_URL=
RAJAONGKIR_DAILY_LIMIT=

# api.co.id (alamat formal / wilayah).
APICOID_API_KEY=

# ---------------------------------------------------------------------
# LOCAL SCRIPTS ONLY (scripts/seed-*.mjs) - tidak dipakai aplikasi
# ---------------------------------------------------------------------
VINCOSME_DEMO_PASSWORD=
CHIRISOL_DEMO_PASSWORD=
ACTIVE_CLIENT_DEMO_PASSWORD=